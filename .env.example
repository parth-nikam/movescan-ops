# Demo mode needs no AWS credentials.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Set DEMO_MODE=false and provide these only to the backend runtime.
AWS_REGION=us-east-1
S3_BUCKET=movescan-video-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mobile receives only the backend URL, never AWS credentials.
EXPO_PUBLIC_API_URL=http://localhost:5173
